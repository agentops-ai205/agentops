# AgentOps production environment template.
# Copy values into the hosting dashboards. Do not commit real secrets.

# API container
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
AGENTOPS_DEFAULT_ORGANIZATION_ID=org.default
AGENTOPS_OPERATOR_TOKEN=replace-with-a-long-random-token
AGENTOPS_ALLOWED_ORIGINS=https://agentops.ai,https://www.agentops.ai,https://agentops-ai205.netlify.app
AGENTOPS_HTTP_BODY_LIMIT_BYTES=1000000
AGENTOPS_RATE_LIMIT_WINDOW_MS=60000
AGENTOPS_RATE_LIMIT_MAX=600
AGENTOPS_PROJECT_ROOT=/app
AGENTOPS_SANDBOX_ROOT=/app/.agentops/sandboxes
AGENTOPS_COMMAND_TIMEOUT_MS=120000
AGENTOPS_SANDBOX_OUTPUT_LIMIT_BYTES=20000
AGENTOPS_SANDBOX_ENGINE=rust_core
AGENTOPS_POLICY_ENGINE=rust_core_strict
AGENTOPS_CORE_CLI_PATH=/app/bin/agentops
AGENTOPS_RUST_POLICY_TIMEOUT_MS=5000
AGENTOPS_MODEL_PROVIDER=manual
AGENTOPS_MODEL_MAX_TOKENS=4000
AGENTOPS_MODEL_TIMEOUT_MS=30000

# Web build
VITE_API_URL=https://agentops-ai205.netlify.app/api
