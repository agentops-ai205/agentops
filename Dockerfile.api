FROM rust:1-bookworm AS rust-build
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates crates
RUN cargo build --release --workspace

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

FROM deps AS build
WORKDIR /app
COPY . .
RUN npm --workspace @agentops/shared run build && npm --workspace @agentops/api run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV API_HOST=0.0.0.0
ENV API_PORT=3000
ENV AGENTOPS_PROJECT_ROOT=/app
ENV AGENTOPS_CORE_CLI_PATH=/app/bin/agentops
ENV AGENTOPS_POLICY_ENGINE=rust_core_strict
ENV AGENTOPS_SANDBOX_ENGINE=rust_core
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/apps/api/package.json apps/api/package.json
COPY --from=build /app/packages/shared/package.json packages/shared/package.json
RUN npm ci --omit=dev
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/apps/api/migrations apps/api/migrations
COPY --from=rust-build /app/target/release/agentops /app/bin/agentops
RUN mkdir -p /app/.agentops/audit /app/.agentops/memory /app/.agentops/policies /app/.agentops/sandboxes \
  && chown -R node:node /app
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npm", "--workspace", "@agentops/api", "run", "start"]
