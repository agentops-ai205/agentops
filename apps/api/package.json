{
  "name": "@agentops/api",
  "version": "1.0.5",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "tsx watch src/localServer.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:local": "node dist/localServer.js",
    "worker": "node dist/worker.js",
    "test": "vitest run --exclude \"**/._*\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "agentops:init": "tsx src/services/kernel.ts"
  },
  "dependencies": {
    "@agentops/shared": "file:../../packages/shared",
    "@fastify/cors": "^10.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "nanoid": "^5.1.5",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.6"
  }
}
