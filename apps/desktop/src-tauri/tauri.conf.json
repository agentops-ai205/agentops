{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentOps IDE",
  "version": "1.0.8",
  "identifier": "ai.agentops.desktop",
  "build": {
    "beforeDevCommand": "cd ../.. && npm run dev:local",
    "beforeBuildCommand": "cd ../.. && npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentOps IDE",
        "label": "main",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3000 http://127.0.0.1:5173; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Governed AI coding IDE",
    "longDescription": "AgentOps IDE combines missions, local files, terminal execution, patch review, evidence and human approvals for governed agentic development."
  }
}
