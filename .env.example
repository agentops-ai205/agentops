DATABASE_URL=postgres://agentops:agentops@127.0.0.1:5432/agentops
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
VITE_API_URL=http://127.0.0.1:3000
AGENTOPS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AGENTOPS_OPERATOR_TOKEN=change-me-in-production
AGENTOPS_HTTP_BODY_LIMIT_BYTES=1000000
AGENTOPS_RATE_LIMIT_WINDOW_MS=60000
AGENTOPS_RATE_LIMIT_MAX=600
AGENTOPS_PROJECT_ROOT=/app
AGENTOPS_DEFAULT_ORGANIZATION_ID=org.default
AGENTOPS_SANDBOX_ROOT=/app/.agentops/sandboxes
AGENTOPS_COMMAND_TIMEOUT_MS=120000
AGENTOPS_SANDBOX_OUTPUT_LIMIT_BYTES=20000
AGENTOPS_SANDBOX_ENGINE=rust_core
AGENTOPS_POLICY_ENGINE=rust_core
AGENTOPS_CORE_CLI_PATH=/app/target/release/agentops
AGENTOPS_RUST_POLICY_TIMEOUT_MS=5000
AGENTOPS_MODEL_PROVIDER=manual
AGENTOPS_MODEL_MAX_TOKENS=4000
AGENTOPS_MODEL_TIMEOUT_MS=30000
